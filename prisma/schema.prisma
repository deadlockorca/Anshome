generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  active
  suspended
  deleted
}

enum RoleCode {
  seeker
  owner
  agent
  agency_admin
  developer
  moderator
  editor
  ops
  super_admin
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum TransactionType {
  sale
  rent
}

enum CategoryTransactionType {
  sale
  rent
  both
}

enum LocationType {
  country
  province
  district
  ward
  street
}

enum ListingStatus {
  draft
  submitted
  pending_review
  published
  rejected
  hidden
  expired
  deleted
}

enum ListingModerationStatus {
  none
  pending
  approved
  rejected
  flagged
}

enum MediaStatus {
  pending
  approved
  rejected
  deleted
}

enum MediaType {
  image
  video
  floor_plan
  document
}

enum LeadStatus {
  new
  contacted
  qualified
  won
  lost
  spam
}

enum ArticleStatus {
  draft
  scheduled
  published
  archived
}

enum ProjectStatus {
  planning
  upcoming
  selling
  handed_over
  paused
  archived
}

enum NotificationChannel {
  in_app
  email
  sms
  zalo
  push
}

enum NotificationStatus {
  pending
  sent
  failed
  cancelled
}

enum DomainEventStatus {
  pending
  processing
  processed
  failed
}

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  profile            Profile?
  roles              UserRole[]
  sessions           Session[]
  agencyMemberships  AgencyMember[]
  listings           Listing[]                @relation("ListingOwner")
  media              Media[]
  leadsSent          Lead[]                   @relation("LeadSender")
  leadsReceived      Lead[]                   @relation("LeadRecipient")
  articles           Article[]                @relation("ArticleAuthor")
  auditLogs          AuditLog[]               @relation("AuditActor")
  listingModerations ListingModerationEvent[] @relation("ListingModerationActor")
  favorites          Favorite[]
  savedSearches      SavedSearch[]
  notifications      Notification[]
  leadEvents         LeadEvent[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  scopeType String?  @map("scope_type")
  scopeId   String?  @map("scope_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent") @db.Text
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Profile {
  userId             String             @id @map("user_id")
  displayName        String             @map("display_name")
  avatarMediaId      String?            @map("avatar_media_id")
  bio                String?            @db.Text
  licenseNumber      String?            @map("license_number")
  companyName        String?            @map("company_name")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  publicSlug         String?            @unique @map("public_slug")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia Media? @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@map("profiles")
}

model Agency {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logoMediaId        String?            @map("logo_media_id")
  phone              String?
  email              String?
  address            String?            @db.Text
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  status             String             @default("active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  logoMedia Media?         @relation("AgencyLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  members   AgencyMember[]
  listings  Listing[]

  @@map("agencies")
}

model AgencyMember {
  id       String   @id @default(cuid())
  agencyId String   @map("agency_id")
  userId   String   @map("user_id")
  role     String
  status   String   @default("active")
  joinedAt DateTime @default(now()) @map("joined_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId])
  @@map("agency_members")
}

model Location {
  id        String       @id @default(cuid())
  parentId  String?      @map("parent_id")
  type      LocationType
  name      String
  slug      String
  fullName  String       @map("full_name")
  oldName   String?      @map("old_name")
  newName   String?      @map("new_name")
  code      String?
  latitude  Decimal?     @db.Decimal(10, 7)
  longitude Decimal?     @db.Decimal(10, 7)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  parent           Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Location[] @relation("LocationTree")
  provinceListings Listing[]  @relation("ListingProvince")
  districtListings Listing[]  @relation("ListingDistrict")
  wardListings     Listing[]  @relation("ListingWard")
  streetListings   Listing[]  @relation("ListingStreet")
  provinceProjects Project[]  @relation("ProjectProvince")
  districtProjects Project[]  @relation("ProjectDistrict")
  wardProjects     Project[]  @relation("ProjectWard")
  streetProjects   Project[]  @relation("ProjectStreet")

  @@unique([type, slug])
  @@index([parentId, type])
  @@map("locations")
}

model Category {
  id              String                  @id @default(cuid())
  parentId        String?                 @map("parent_id")
  transactionType CategoryTransactionType @map("transaction_type")
  code            String                  @unique
  name            String
  slug            String                  @unique
  isActive        Boolean                 @default(true) @map("is_active")
  sortOrder       Int                     @default(0) @map("sort_order")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  listings Listing[]
  projects Project[]

  @@index([transactionType, isActive])
  @@map("categories")
}

model Listing {
  id               String                  @id @default(cuid())
  publicId         String                  @unique @map("public_id")
  ownerUserId      String                  @map("owner_user_id")
  agencyId         String?                 @map("agency_id")
  projectId        String?                 @map("project_id")
  transactionType  TransactionType         @map("transaction_type")
  categoryId       String                  @map("category_id")
  title            String
  slug             String
  description      String                  @db.Text
  status           ListingStatus           @default(draft)
  moderationStatus ListingModerationStatus @default(none) @map("moderation_status")
  price            Decimal?                @db.Decimal(18, 2)
  priceUnit        String?                 @map("price_unit")
  area             Decimal?                @db.Decimal(12, 2)
  pricePerSqm      Decimal?                @map("price_per_sqm") @db.Decimal(18, 2)
  provinceId       String?                 @map("province_id")
  districtId       String?                 @map("district_id")
  wardId           String?                 @map("ward_id")
  streetId         String?                 @map("street_id")
  addressText      String?                 @map("address_text") @db.Text
  latitude         Decimal?                @db.Decimal(10, 7)
  longitude        Decimal?                @db.Decimal(10, 7)
  contactName      String                  @map("contact_name")
  contactPhone     String                  @map("contact_phone")
  isVerified       Boolean                 @default(false) @map("is_verified")
  isFeatured       Boolean                 @default(false) @map("is_featured")
  publishedAt      DateTime?               @map("published_at")
  expiredAt        DateTime?               @map("expired_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  owner            User                     @relation("ListingOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  agency           Agency?                  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  project          Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category         Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  province         Location?                @relation("ListingProvince", fields: [provinceId], references: [id], onDelete: SetNull)
  district         Location?                @relation("ListingDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  ward             Location?                @relation("ListingWard", fields: [wardId], references: [id], onDelete: SetNull)
  street           Location?                @relation("ListingStreet", fields: [streetId], references: [id], onDelete: SetNull)
  attributes       ListingAttribute?
  media            ListingMedia[]
  leads            Lead[]
  favorites        Favorite[]
  moderationEvents ListingModerationEvent[]

  @@index([status, transactionType, categoryId])
  @@index([provinceId, districtId, wardId])
  @@index([price])
  @@index([area])
  @@index([pricePerSqm])
  @@index([publishedAt])
  @@index([isVerified])
  @@map("listings")
}

model ListingAttribute {
  listingId        String   @id @map("listing_id")
  bedrooms         Int?
  bathrooms        Int?
  floors           Int?
  frontageWidth    Decimal? @map("frontage_width") @db.Decimal(8, 2)
  roadWidth        Decimal? @map("road_width") @db.Decimal(8, 2)
  direction        String?
  balconyDirection String?  @map("balcony_direction")
  legalStatus      String?  @map("legal_status")
  interiorStatus   String?  @map("interior_status")
  handoverStatus   String?  @map("handover_status")
  usableArea       Decimal? @map("usable_area") @db.Decimal(12, 2)
  landArea         Decimal? @map("land_area") @db.Decimal(12, 2)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_attributes")
}

model ListingMedia {
  id               String      @id @default(cuid())
  listingId        String      @map("listing_id")
  mediaId          String      @map("media_id")
  type             MediaType
  sortOrder        Int         @default(0) @map("sort_order")
  caption          String?
  moderationStatus MediaStatus @default(pending) @map("moderation_status")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listingId, mediaId])
  @@index([mediaId])
  @@map("listing_media")
}

model ListingModerationEvent {
  id           String   @id @default(cuid())
  listingId    String   @map("listing_id")
  actorUserId  String   @map("actor_user_id")
  action       String
  reasonCode   String?  @map("reason_code")
  note         String?  @db.Text
  beforeStatus String?  @map("before_status")
  afterStatus  String?  @map("after_status")
  createdAt    DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor   User    @relation("ListingModerationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([actorUserId])
  @@map("listing_moderation_events")
}

model Media {
  id          String      @id @default(cuid())
  ownerUserId String?     @map("owner_user_id")
  storageKey  String      @unique @map("storage_key")
  publicUrl   String      @map("public_url") @db.Text
  mimeType    String      @map("mime_type")
  sizeBytes   Int         @map("size_bytes")
  width       Int?
  height      Int?
  checksum    String?
  status      MediaStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at")

  owner          User?          @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  listingMedia   ListingMedia[]
  profileAvatars Profile[]      @relation("ProfileAvatar")
  agencyLogos    Agency[]       @relation("AgencyLogo")
  developerLogos Developer[]    @relation("DeveloperLogo")
  projectMedia   ProjectMedia[]
  articleCovers  Article[]      @relation("ArticleCover")

  @@index([ownerUserId])
  @@map("media")
}

model Developer {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  description        String?            @db.Text
  logoMediaId        String?            @map("logo_media_id")
  website            String?
  phone              String?
  email              String?
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  logoMedia Media?    @relation("DeveloperLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  projects  Project[]

  @@map("developers")
}

model Project {
  id          String        @id @default(cuid())
  developerId String?       @map("developer_id")
  name        String
  slug        String
  description String?       @db.Text
  status      ProjectStatus @default(upcoming)
  categoryId  String?       @map("category_id")
  provinceId  String?       @map("province_id")
  districtId  String?       @map("district_id")
  wardId      String?       @map("ward_id")
  streetId    String?       @map("street_id")
  addressText String?       @map("address_text") @db.Text
  latitude    Decimal?      @db.Decimal(10, 7)
  longitude   Decimal?      @db.Decimal(10, 7)
  landArea    Decimal?      @map("land_area") @db.Decimal(14, 2)
  totalUnits  Int?          @map("total_units")
  priceMin    Decimal?      @map("price_min") @db.Decimal(18, 2)
  priceMax    Decimal?      @map("price_max") @db.Decimal(18, 2)
  priceUnit   String?       @map("price_unit")
  legalStatus String?       @map("legal_status")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  developer Developer?     @relation(fields: [developerId], references: [id], onDelete: SetNull)
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  province  Location?      @relation("ProjectProvince", fields: [provinceId], references: [id], onDelete: SetNull)
  district  Location?      @relation("ProjectDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  ward      Location?      @relation("ProjectWard", fields: [wardId], references: [id], onDelete: SetNull)
  street    Location?      @relation("ProjectStreet", fields: [streetId], references: [id], onDelete: SetNull)
  listings  Listing[]
  media     ProjectMedia[]
  leads     Lead[]

  @@unique([slug])
  @@index([status])
  @@index([provinceId, districtId])
  @@map("projects")
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  mediaId   String    @map("media_id")
  type      MediaType
  sortOrder Int       @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId])
  @@index([mediaId])
  @@map("project_media")
}

model Lead {
  id              String     @id @default(cuid())
  sourceType      String     @map("source_type")
  sourceId        String     @map("source_id")
  listingId       String?    @map("listing_id")
  projectId       String?    @map("project_id")
  recipientUserId String?    @map("recipient_user_id")
  senderUserId    String?    @map("sender_user_id")
  name            String
  phone           String?
  email           String?
  message         String?    @db.Text
  status          LeadStatus @default(new)
  utmSource       String?    @map("utm_source")
  utmMedium       String?    @map("utm_medium")
  utmCampaign     String?    @map("utm_campaign")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  listing   Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recipient User?       @relation("LeadRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  sender    User?       @relation("LeadSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  events    LeadEvent[]

  @@index([sourceType, sourceId])
  @@index([recipientUserId, status])
  @@index([listingId])
  @@map("leads")
}

model LeadEvent {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  actorUserId String?  @map("actor_user_id")
  eventType   String   @map("event_type")
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("lead_events")
}

model Favorite {
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("favorites")
}

model SavedSearch {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  queryJson  Json      @map("query_json")
  frequency  String    @default("daily")
  lastSentAt DateTime? @map("last_sent_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("saved_searches")
}

model Article {
  id             String        @id @default(cuid())
  authorUserId   String?       @map("author_user_id")
  categoryId     String?       @map("category_id")
  title          String
  slug           String        @unique
  excerpt        String?       @db.Text
  body           String        @db.LongText
  coverMediaId   String?       @map("cover_media_id")
  status         ArticleStatus @default(draft)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description") @db.Text
  canonicalUrl   String?       @map("canonical_url")
  noindex        Boolean       @default(false)
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  author     User?            @relation("ArticleAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverMedia Media?           @relation("ArticleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  tags       ArticleTagLink[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model ArticleCategory {
  id             String   @id @default(cuid())
  parentId       String?  @map("parent_id")
  name           String
  slug           String   @unique
  description    String?  @db.Text
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parent   ArticleCategory?  @relation("ArticleCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ArticleCategory[] @relation("ArticleCategoryTree")
  articles Article[]

  @@map("article_categories")
}

model ArticleTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  articles ArticleTagLink[]

  @@map("article_tags")
}

model ArticleTagLink {
  articleId String @map("article_id")
  tagId     String @map("tag_id")

  article Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tag_links")
}

model Notification {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  channel      NotificationChannel
  templateCode String              @map("template_code")
  payloadJson  Json                @map("payload_json")
  status       NotificationStatus  @default(pending)
  scheduledAt  DateTime?           @map("scheduled_at")
  sentAt       DateTime?           @map("sent_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([scheduledAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model DomainEvent {
  id          String            @id @default(cuid())
  eventType   String            @map("event_type")
  entityType  String            @map("entity_type")
  entityId    String            @map("entity_id")
  payloadJson Json              @map("payload_json")
  status      DomainEventStatus @default(pending)
  createdAt   DateTime          @default(now()) @map("created_at")
  processedAt DateTime?         @map("processed_at")

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@map("domain_events")
}
